{
  "schemaVersion": "1.4",
  "authorityRepository": "jaypVLabs/JPV-OS",
  "authorityRef": "main",
  "surfaceRole": "BOUNDED_COMPATIBILITY",
  "localAuthoritativeGovernanceAllowed": false,
  "requiredStandards": [
    "governance/GOVERNING-INTENT-EQUILIBRIUM-STANDARD.md",
    "governance/SYSTEM-CONSISTENCY-INTEGRITY-STANDARD.md",
    "governance/ARTIFACT-CONTEXT-CURATION-STANDARD.md",
    "governance/standards/INVESTIGATIVE-EVIDENCE-PIPELINE-INVARIANT.md",
    "governance/inherited/cost-integrity-invariant.json",
    ".jpv/governance/detection-attribution-evidence-invariant.json"
  ],
  "requiredPolicies": ["governance/policies/device-independent-execution.v1.json"],
  "requiredContracts": [
    "governance/contracts/governing-intent-equilibrium.v1.json",
    "governance/contracts/system-consistency-integrity.v1.json",
    "governance/contracts/artifact-success-gate.v1.json",
    "governance/contracts/investigative-evidence-pipeline.v1.json"
  ],
  "requiredInheritance": ["governance/security/JPV-SECURITY-INHERITANCE.json"],
  "rules": {
    "governingOutcomeOverridesLocalOptimization": true,
    "semanticIntentDeterminesToolRouting": true,
    "establishedCorrectionsApplyBeforeExecution": true,
    "repeatedFailureEscalatesToPathBlock": true,
    "mutationSuccessIsNotCompletion": true,
    "founderRediscoveryRequired": false,
    "downstreamRulesMayNotWeakenAuthority": true,
    "investigativeEvidencePipelineRequired": true,
    "entityResolutionPrecedesAssociation": true,
    "inferenceMustRemainDistinctFromFact": true,
    "uncertainOrHighMaterialityRequiresReview": true,
    "investigativeRecordsAreAppendOnly": true,
    "materialCostMustRemainLegible": true,
    "avoidableCostExternalizationForbidden": true,
    "detectionDistinctFromAttribution": true,
    "unknownCauseIsValidState": true,
    "unsupportedMotiveIntentCoordinationCausationForbidden": true,
    "securityAgentFleetRequired": true,
    "securityStateObservable": true,
    "trackedSecretScanRequired": true,
    "leastPrivilegeRequired": true,
    "securityReceiptRequired": true,
    "unverifiableSecurityStateFailsClosed": true,
    "githubActionsExecutionSurfaceAllowed": false,
    "cloudAndProductionExecutionDeviceIndependent": true,
    "founderLaptopExecutionDependencyAllowed": false,
    "founderCheckoutDependencyAllowed": false,
    "manualFounderRecoveryFallbackAllowed": false,
    "localMachineCloudFallbackAllowed": false,
    "hostedFailureBehavior": "SELF_RECOVER_OR_FAIL_CLOSED",
    "localExecutionException": "EXPLICIT_DEVICE_BOUND_CAPABILITY_ONLY",
    "localCanonicalCompletionAuthorityAllowed": false
  },
  "enforcement": "fail_closed"
}
